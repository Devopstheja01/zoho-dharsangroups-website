# Zoho Inventory API Configuration - India Data Center
# Copy this file to .env.local and fill in your actual credentials

ZOHO_ORGANIZATION_ID=your_organization_id_here
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_refresh_token_here
ZOHO_API_DOMAIN=https://www.zohoapis.in

# Note: This is for the India data center (zoho.in)
# Keep .env.local secure and never commit to Git!
